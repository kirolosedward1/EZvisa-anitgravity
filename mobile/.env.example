# Copy to .env (git-ignored).
# Live website DB: Supabase project ezvisa-uae (ref dravvaykssrbktztmrlj). Use the PUBLISHABLE key (sb_publishable_...) or legacy anon key.
# Never put a service-role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://dravvaykssrbktztmrlj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Official website (must be https://www.ezvisa.net; anything else is ignored by lib/config.ts).
EXPO_PUBLIC_SITE_URL=https://www.ezvisa.net
# Crash reporting (Sentry, approved 2026-10-22; lib/sentry.ts). Sentry › Project settings › Client Keys (DSN).
# The DSN is a public client key, not a secret. Leave empty to turn reporting off. Also set it in the EAS preview environment.
EXPO_PUBLIC_SENTRY_DSN=
