# Copy to .env and fill in. These are public values (they ship inside the app).
# Must be the SAME Supabase project the website uses, so accounts and data are shared.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The deployed Next.js site that hosts /api/mobile/v1 (use your Vercel preview URL while testing this branch).
EXPO_PUBLIC_API_URL=https://www.ezvisa.net
